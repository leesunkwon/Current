<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Current" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/current_accent</item>
        <item name="android:fontFamily">@font/pretendard_regular</item>
    </style>
    <style name="Theme.Current.Pdf" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorAccent">@color/current_accent</item>
        <item name="android:colorAccent">@color/current_accent</item>
        <item name="android:fontFamily">@font/pretendard_regular</item>
    </style>
    <style name="Theme.Current.UploadDialog.Light" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/current_dialog_light</item>
        <item name="android:fontFamily">@font/pretendard_regular</item>
        <item name="android:textColorPrimary">#FF000000</item>
        <item name="android:textColorSecondary">#FF424242</item>
        <item name="android:colorAccent">#FF000000</item>
    </style>
    <style name="Theme.Current.UploadDialog.Dark" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/current_dialog_dark</item>
        <item name="android:fontFamily">@font/pretendard_regular</item>
        <item name="android:textColorPrimary">#FFFFFFFF</item>
        <item name="android:textColorSecondary">#FFD4D4D4</item>
        <item name="android:colorAccent">#FFFFFFFF</item>
    </style>
</resources>
